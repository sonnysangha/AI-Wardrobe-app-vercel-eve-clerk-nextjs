map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 3000;
  large_client_header_buffers 4 32k;

  location / {
    proxy_pass http://web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # The sandbox proxy terminates TLS and rewrites Host to the sandbox domain. Tell the app the
    # public https origin so Clerk's handshake redirect_url stays https on the preview host.
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host "3000-${BASE44_PUBLIC_HOST_SUFFIX}";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_read_timeout 3600s;
  }
}
