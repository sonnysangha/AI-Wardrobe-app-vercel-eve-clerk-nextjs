# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.base44-defaults

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# convex local dev, eve build output
.convex/
.eve/
.output/

# pnpm content-addressable store when installed with a project-local store-dir
.pnpm-store/

# local agent outputs (smoke-test images etc.)
Claude outputs/

# Local QA screenshots and private image references
artifacts/verification/
/verification/
/.codex/
